--- !u!114 &388781502
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 388781499}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 053183ece2e61ec4faa6bc0ccbfb93f1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nameText: {fileID: 438279439}
  messageText: {fileID: 1027719736}
  typingSpeed: 0.03
  nobodyScenario:
    scenarioName: TalkedToNoBodyScenario
    lines:
    - characterName: John
      text: No survivors
    - characterName: John
      text: I did not find the girl and her mother
  manOnlyScenario:
    scenarioName: TalkedToTheManScenario
    lines:
    - characterName: John
      text: I did not find the girl.
    - characterName: John
      text: Drop the nuke.
    - characterName: Soldier
      text: Was there any survivors?
    - characterName: John
      text: Yes
    - characterName: Soldier
      text: We will drop some squads to eliminate the infected and save as much survivors
        as we can.
    - characterName: John
      text: As I remember this was not the plan.
    - characterName: Soldier
      text: Yes, our main plan was to save minister's family but now we can save
        people as we failed the mission.
    - characterName: John
      text: I talked to a man named Daniel near the landing site.
    - characterName: Soldier
      text: Roger that.
  womanOrBothScenario:
    scenarioName: TalkedToBothScenario
    lines:
    - characterName: John
      text: We are safe and in the helicopter.
    - characterName: John
      text: Drop the nuke.
    - characterName: Sarah
      text: What?
    - characterName: Sarah
      text: They wil die, I saw healthy people. You lied to me
    - characterName: John
      text: We cannot risk them leaving the city and being infected.
    - characterName: Sarah
      text: Why only me?
    - characterName: John
      text: Because of your father, world is not fair.
    - characterName: Sarah
      text: That's wrong
    - characterName: John
      text: One day you will understand
