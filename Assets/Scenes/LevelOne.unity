  dialogueLines:
  - characterName: Girl
    text: Sir
  - characterName: John
    text: What's your name?
  - characterName: Sarah
    text: Sarah
  - characterName: John
    text: I came to save you, where is you mother?
  - characterName: Sarah
    text: Mother
  - characterName: Sarah
    text: She died trying to protect me from the the people that were running after
      us
  - characterName: Sarah
    text: She died for me to live
  - characterName: John
    text: I'm
  - characterName: John
    text: I'm sorry
  - characterName: John
    text: Let's get going
  - characterName: John
    text: We are going to the city park nearby there is a helicopter waiting for
      us.
  - characterName: Sarah
    text: What will happen to the rest of the people?
  - characterName: John
    text: Help will come for them later, follow me!!
  - characterName: 'Sarah '
    text: Okay
  detectionRange: 8
